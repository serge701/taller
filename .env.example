# Copia este archivo como ".env" en el entorno real (local o producción) y ajusta
# los valores. El ".env" nunca se sube a git (ver .gitignore).

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taller
DB_USER=root
DB_PASS=

# --- Aplicación ---
APP_ENV=local
# En producción: APP_DEBUG=false (oculta detalles de errores a los visitantes)
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
